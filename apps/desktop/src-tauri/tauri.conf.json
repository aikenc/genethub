{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneHub-dev",
  "version": "0.0.0",
  "identifier": "com.genethub.desktop.dev",
  "mainBinaryName": "genethub-desktop-dev",
  "build": {
    "frontendDist": "../boot",
    "beforeDevCommand": "npm --prefix ../../packages/web run dev",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GeneHub Dev",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "backgroundColor": "#181B1A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh",
        "template": "installer.nsi"
      }
    },
    "shortDescription": "在自己的电脑上跑 agent",
    "longDescription": "GeneHub 桌面端：内置 daemon 与默认 agent，托盘常驻，手机与浏览器随时遥控这台电脑。"
  }
}
