{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneHub",
  "version": "0.1.0",
  "identifier": "com.genethub.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "GeneHub",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://hub.genethub.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "bin/": "bin/"
    },
    "shortDescription": "在自己的电脑上跑 agent",
    "longDescription": "GeneHub 桌面端：内置 daemon 与默认 agent，托盘常驻，手机与浏览器随时遥控这台电脑。"
  }
}
