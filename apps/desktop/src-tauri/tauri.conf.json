{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneHub",
  "version": "0.1.0",
  "identifier": "com.genethub.desktop",
  "build": {
    "frontendDist": "../../../packages/web/dist",
    "beforeBuildCommand": "npm --prefix ../../packages/web run build",
    "beforeDevCommand": "npm --prefix ../../packages/web run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GeneHub",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    },
    "shortDescription": "在自己的电脑上跑 agent",
    "longDescription": "GeneHub 桌面端：内置 daemon 与默认 agent，托盘常驻，手机与浏览器随时遥控这台电脑。"
  }
}
