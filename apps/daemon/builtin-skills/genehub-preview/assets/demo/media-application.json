{
  "name": "原生 WebRTC 连通性示例",
  "entry": "index.html",
  "dataPolicy": "auto",
  "backends": [
    {
      "origin": "http://127.0.0.1:18011",
      "command": [
        "python",
        "media.py"
      ],
      "health": "/health",
      "routes": [
        {
          "prefix": "/api/media/",
          "websocket": false
        }
      ],
      "env": {
        "PREVIEW_MEDIA_PORT": "18011"
      }
    }
  ],
  "media": {
    "offerPath": "/api/media/offer",
    "stopPath": "/api/media/stop",
    "microphone": "webrtc"
  }
}
