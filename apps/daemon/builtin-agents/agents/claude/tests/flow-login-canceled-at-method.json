{
  "kind": "agent",
  "description": "cancelling the account choice ends quietly and starts no login process",
  "cli": {
    "hello": {
      "model": "sonnet",
      "models": [
        {
          "value": "sonnet",
          "displayName": "Sonnet"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.1.0",
    "authLogin": {
      "print": [
        "Visit https://claude.ai/oauth/authorize?code=true&client_id=abc to sign in"
      ],
      "code": "x"
    }
  },
  "steps": [
    {
      "run": "login",
      "answers": [
        {
          "type": "answered",
          "optionId": "cancel"
        }
      ],
      "expect": {
        "result": "done: 已取消登录",
        "cards": [],
        "state": {
          "ready": false
        },
        "runsExclude": [
          "auth login"
        ]
      }
    }
  ]
}
