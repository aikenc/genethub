{
  "kind": "session",
  "description": "a question the person does not answer is denied, not guessed",
  "launch": {
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "models": [
      "sonnet",
      "opus"
    ],
    "efforts": [
      "low",
      "high"
    ]
  },
  "config": {
    "modeId": "bypassPermissions"
  },
  "cli": {
    "turns": [
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "sess-1"
          },
          {
            "type": "control_request",
            "request_id": "q1",
            "request": {
              "subtype": "can_use_tool",
              "tool_name": "AskUserQuestion",
              "input": {
                "questions": [
                  {
                    "question": "Which color?",
                    "header": "Color",
                    "options": [
                      {
                        "label": "Red",
                        "description": "warm"
                      },
                      {
                        "label": "Blue"
                      }
                    ],
                    "multiSelect": false
                  }
                ]
              },
              "tool_use_id": "tu1"
            }
          }
        ],
        "await": "q1",
        "thenAllow": [
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ],
        "thenDeny": [
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": "ask me",
      "wait": false
    },
    {
      "waitFor": "permissionRequested"
    },
    {
      "respond": {
        "outcome": "canceled"
      }
    },
    {
      "waitTerminal": 1
    }
  ],
  "expect": {
    "received": [
      {
        "type": "user"
      },
      {
        "type": "control_response",
        "response": {
          "request_id": "q1",
          "response": {
            "behavior": "deny",
            "allowed": false
          }
        }
      }
    ]
  }
}
