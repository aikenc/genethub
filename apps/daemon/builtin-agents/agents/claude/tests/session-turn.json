{
  "kind": "session",
  "description": "a prompt starts the CLI lazily; the second prompt reuses it; the session id is persisted; the user frame carries the text",
  "launch": {
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "models": [
      "sonnet",
      "opus"
    ],
    "efforts": [
      "low",
      "high"
    ],
    "defaultModel": "sonnet"
  },
  "cli": {
    "turns": [
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "sess-1"
          },
          {
            "type": "assistant",
            "message": {
              "id": "m-one",
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "one"
                }
              ]
            }
          },
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      },
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "sess-1"
          },
          {
            "type": "assistant",
            "message": {
              "id": "m-two",
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "two"
                }
              ]
            }
          },
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": "hi"
    },
    {
      "send": "again"
    }
  ],
  "expect": {
    "runs": [
      {
        "has": [
          "--print",
          [
            "--input-format",
            "stream-json"
          ],
          [
            "--output-format",
            "stream-json"
          ],
          "--include-partial-messages",
          "--allow-dangerously-skip-permissions",
          [
            "--permission-mode",
            "bypassPermissions"
          ]
        ],
        "lacks": [
          "--resume",
          "--model"
        ]
      }
    ],
    "persist": [
      {
        "sessionId": "sess-1"
      }
    ],
    "received": [
      {
        "type": "user",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "hi"
            }
          ]
        }
      },
      {
        "type": "user",
        "message": {
          "content": [
            {
              "type": "text",
              "text": "again"
            }
          ]
        }
      }
    ],
    "terminals": [
      {
        "type": "turnCompleted",
        "turnId": "turn_0"
      },
      {
        "type": "turnCompleted",
        "turnId": "turn_1"
      }
    ]
  }
}
