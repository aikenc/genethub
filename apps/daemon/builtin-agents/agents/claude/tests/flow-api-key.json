{
  "kind": "agent",
  "description": "an API key typed into the password box goes to the daemon and the CLI's environment, is saved owner-only, never logged, and logging out forgets it",
  "cli": {
    "hello": {
      "model": "sonnet",
      "models": [
        {
          "value": "sonnet",
          "displayName": "Sonnet"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.1.0"
  },
  "neverLogged": [
    "sk-ant-secret-1"
  ],
  "steps": [
    {
      "run": "login-api-key",
      "answers": [
        {
          "type": "answered",
          "optionId": "save",
          "answers": [
            {
              "questionId": "key",
              "selectedOptionIds": [],
              "freeformText": "sk-ant-secret-1"
            }
          ]
        }
      ],
      "expect": {
        "result": "done: 已用 API Key 登录",
        "suspended": [
          {
            "step": "login.api-key",
            "title": "用 API Key 登录 Claude Code",
            "questions": [
              {
                "id": "key",
                "input": "secret"
              }
            ]
          }
        ],
        "env": {
          "ANTHROPIC_API_KEY": "sk-ant-secret-1"
        },
        "credentials": true,
        "state": {
          "ready": true,
          "actions": [
            {
              "id": "login-api-key"
            },
            {
              "id": "logout"
            },
            {
              "id": "update"
            },
            {
              "id": "space-own"
            }
          ]
        },
        "neverLogged": [
          "sk-ant-secret-1"
        ]
      }
    },
    {
      "run": "logout",
      "expect": {
        "result": "done: 已退出登录",
        "env": {
          "ANTHROPIC_API_KEY": null
        },
        "credentials": false,
        "state": {
          "ready": false,
          "actions": [
            {
              "id": "login"
            },
            {
              "id": "login-api-key"
            },
            {
              "id": "space-own"
            }
          ]
        },
        "runsInclude": [
          "auth logout"
        ]
      }
    }
  ]
}
