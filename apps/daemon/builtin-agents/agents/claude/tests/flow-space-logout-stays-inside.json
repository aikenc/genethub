{
  "kind": "agent",
  "cli": {
    "hello": {
      "model": "sonnet",
      "models": [
        {
          "value": "sonnet",
          "displayName": "Sonnet"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.1.0",
    "logEnv": [
      "CLAUDE_CONFIG_DIR",
      "ANTHROPIC_API_KEY"
    ]
  },
  "description": "in an own space a key login and logout work inside the space and the machine's own directory is never given to the CLI",
  "neverLogged": [
    "sk-ant-space"
  ],
  "steps": [
    {
      "run": "space-own",
      "answers": [
        {
          "type": "answered",
          "optionId": "switch"
        }
      ],
      "expect": {
        "space": true
      }
    },
    {
      "run": "login-api-key",
      "answers": [
        {
          "type": "answered",
          "optionId": "save",
          "answers": [
            {
              "questionId": "key",
              "selectedOptionIds": [],
              "freeformText": "sk-ant-space"
            }
          ]
        }
      ],
      "expect": {
        "result": "done: 已用 API Key 登录",
        "lastRunEnv": {
          "CLAUDE_CONFIG_DIR": "<space>"
        },
        "state": {
          "ready": true,
          "message": "现在用的是独立空间：登录、配置和历史都放在 GeneHub 自己的目录里，和这台机器上的 Claude Code 分开。"
        }
      }
    },
    {
      "run": "logout",
      "expect": {
        "result": "done: 已退出登录",
        "lastRunEnv": {
          "CLAUDE_CONFIG_DIR": "<space>"
        },
        "space": true,
        "state": {
          "ready": false
        }
      }
    }
  ]
}
