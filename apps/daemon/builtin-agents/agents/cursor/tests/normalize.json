      "config": {
        "modelId": "grok-4.7[effort=low,fast=true]"
      },
      "expect": {
        "modelId": "grok-4.7",
        "effortId": "low",
        "fast": true,
        "slug": "grok-4.7-low-fast",
        "events": [
          {
            "type": "modelChanged",
            "modelId": "grok-4.7"
          },
          {
            "type": "effortChanged",
