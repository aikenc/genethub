          },
          {
            "type": "fastChanged",
            "fast": true
          }
        ]
      }
    },
    {
      "config": {
        "modelId": "grok-4.7[effort=low,fast=true]",
        "effortId": "medium",
        "fast": false
      },
      "expect": {
        "modelId": "grok-4.7",
        "effortId": "medium",
        "fast": false,
        "slug": "grok-4.7-medium",
        "events": [
          {
            "type": "modelChanged",
            "modelId": "grok-4.7"
          }
        ]
      }
    },
    {
      "config": {
        "modelId": "cursor-grok-4.6-high-fast"
