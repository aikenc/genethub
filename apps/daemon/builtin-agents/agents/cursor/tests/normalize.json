            "type": "modelChanged",
            "modelId": "auto"
          },
          {
            "type": "modeChanged",
            "modeId": "agent"
          },
          {
            "type": "fastChanged",
            "fast": false
          }
        ]
      }
    },
    {
      "config": {
        "modelId": "grok-4.7",
        "effortId": "xhigh",
