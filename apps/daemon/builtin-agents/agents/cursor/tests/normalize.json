{
  "kind": "normalize",
  "description": "saved selections are migrated or replaced at session start (old manager.rs normalize_runtime_selection + resolve_legacy_cursor_model)",
  "cliList": "auto - Auto (default)\ncursor-grok-4.6-high-fast - Cursor Grok 4.6 Fast\ncursor-grok-4.6-high - Cursor Grok 4.6\ngrok-4.7-low - Grok 4.7 Low\ngrok-4.7-low-fast - Grok 4.7 Low Fast\ngrok-4.7-medium - Grok 4.7 Medium\ncomposer-2.5 - Composer 2.5\n",
  "sessions": [
