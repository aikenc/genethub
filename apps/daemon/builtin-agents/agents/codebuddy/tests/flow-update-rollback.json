{
  "kind": "agent",
  "description": "a new version that does not start is rolled back",
  "cli": {
    "hello": {
      "currentModelId": "glm",
      "models": [
        {
          "id": "glm",
          "name": "GLM"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": true,
    "version": "2.5.0",
    "logEnv": [
      "CODEBUDDY_INTERNET_ENVIRONMENT"
    ],
    "latest": "2.6.0",
    "brokenVersions": [
      "2.6.0"
    ]
  },
  "steps": [
    {
      "refresh": true,
      "expect": {
        "state": {
          "version": "2.5.0"
        }
      }
    },
    {
      "run": "update",
      "expect": {
        "result": "error: 新版本 CodeBuddy 无法启动，已回到 2.5.0",
        "state": {
          "version": "2.5.0"
        }
      }
    }
  ]
}
