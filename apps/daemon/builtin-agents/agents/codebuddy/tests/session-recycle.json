{
  "kind": "session",
  "description": "after credentials change the next prompt runs in a new process that resumes the session",
  "launch": {
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "models": [
      "sonnet",
      "opus"
    ],
    "efforts": [
      "low",
      "high"
    ],
    "defaultModel": "sonnet"
  },
  "cli": {
    "turns": [
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "same"
          },
          {
            "type": "assistant",
            "message": {
              "id": "m-one",
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "one"
                }
              ]
            }
          },
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      },
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "same"
          },
          {
            "type": "assistant",
            "message": {
              "id": "m-two",
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "two"
                }
              ]
            }
          },
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": "one"
    },
    {
      "recycle": true
    },
    {
      "send": "two"
    }
  ],
  "expect": {
    "runs": [
      {
        "lacks": [
          "--resume"
        ]
      },
      {
        "has": [
          [
            "--resume",
            "same"
          ]
        ]
      }
    ],
    "terminals": [
      {
        "type": "turnCompleted"
      },
      {
        "type": "turnCompleted"
      }
    ]
  }
}
