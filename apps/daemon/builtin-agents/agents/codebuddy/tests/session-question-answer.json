{
  "kind": "session",
  "description": "AskUserQuestion is shown as a question, never auto-allowed, and the chosen label returns as the answer",
  "launch": {
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "models": [
      "sonnet",
      "opus"
    ],
    "efforts": [
      "low",
      "high"
    ]
  },
  "config": {
    "modeId": "bypassPermissions"
  },
  "cli": {
    "turns": [
      {
        "emit": [
          {
            "type": "system",
            "subtype": "init",
            "session_id": "sess-1"
          },
          {
            "type": "control_request",
            "request_id": "q1",
            "request": {
              "subtype": "can_use_tool",
              "tool_name": "AskUserQuestion",
              "input": {
                "questions": [
                  {
                    "question": "Which color?",
                    "header": "Color",
                    "options": [
                      {
                        "label": "Red",
                        "description": "warm"
                      },
                      {
                        "label": "Blue"
                      }
                    ],
                    "multiSelect": false
                  }
                ]
              },
              "tool_use_id": "tu1"
            }
          }
        ],
        "await": "q1",
        "thenAllow": [
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ],
        "thenDeny": [
          {
            "type": "result",
            "subtype": "success",
            "is_error": false
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": "ask me",
      "wait": false
    },
    {
      "waitFor": "permissionRequested"
    },
    {
      "respond": {
        "outcome": "answered",
        "answers": [
          {
            "questionId": "0",
            "selectedOptionIds": [
              "1"
            ],
            "freeformText": "maybe teal"
          }
        ]
      }
    },
    {
      "waitTerminal": 1
    }
  ],
  "expect": {
    "asked": [
      {
        "type": "permissionRequested",
        "request": {
          "id": "q1",
          "kind": "question",
          "title": "Color",
          "questions": [
            {
              "id": "0",
              "prompt": "Which color?",
              "allowMultiple": false,
              "allowFreeform": true,
              "options": [
                {
                  "id": "0",
                  "label": "Red"
                },
                {
                  "id": "1",
                  "label": "Blue"
                }
              ]
            }
          ]
        }
      },
      {
        "type": "permissionResolved"
      }
    ],
    "received": [
      {
        "type": "user"
      },
      {
        "type": "control_response",
        "response": {
          "request_id": "q1",
          "response": {
            "behavior": "allow",
            "allowed": true,
            "updatedInput": {
              "answers": {
                "Which color?": "Blue\nadded note (verbatim): maybe teal"
              }
            }
          }
        }
      }
    ]
  }
}
