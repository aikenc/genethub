{
  "kind": "agent",
  "description": "cancelling on the link card ends the login process and leaves no card open",
  "cli": {
    "hello": {
      "currentModelId": "glm",
      "models": [
        {
          "id": "glm",
          "name": "GLM"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.5.0",
    "logEnv": [
      "CODEBUDDY_INTERNET_ENVIRONMENT"
    ],
    "acp": {
      "url": "https://www.codebuddy.ai/auth?state=abc123",
      "hold": 30,
      "verdict": "ok"
    }
  },
  "timeout": 60,
  "steps": [
    {
      "run": "login",
      "answers": [
        {
          "type": "answered",
          "optionId": "external"
        }
      ],
      "live": [
        {
          "type": "answered",
          "optionId": "cancel"
        }
      ],
      "expect": {
        "result": "done: 已取消登录",
        "cards": [
          {
            "display": [
              {
                "kind": "link"
              }
            ]
          }
        ],
        "state": {
          "ready": false,
          "actions": [
            {
              "id": "login"
            },
            {
              "id": "login-api-key"
            }
          ]
        }
      }
    }
  ]
}
