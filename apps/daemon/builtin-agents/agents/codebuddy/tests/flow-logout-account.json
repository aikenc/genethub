{
  "kind": "agent",
  "description": "logging out of an account sends the CLI its own logout request and the card goes back to logged out",
  "cli": {
    "hello": {
      "currentModelId": "glm",
      "models": [
        {
          "id": "glm",
          "name": "GLM"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": true,
    "version": "2.5.0",
    "logEnv": [
      "CODEBUDDY_INTERNET_ENVIRONMENT"
    ]
  },
  "steps": [
    {
      "refresh": true,
      "expect": {
        "state": {
          "ready": true
        }
      }
    },
    {
      "run": "logout",
      "expect": {
        "result": "done: 已退出登录",
        "state": {
          "ready": false
        }
      }
    }
  ]
}
