{
  "kind": "agent",
  "description": "the iOA sign-in talks to its own service from the start",
  "cli": {
    "hello": {
      "currentModelId": "glm",
      "models": [
        {
          "id": "glm",
          "name": "GLM"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.5.0",
    "logEnv": [
      "CODEBUDDY_INTERNET_ENVIRONMENT"
    ],
    "acp": {
      "url": "https://www.codebuddy.ai/auth?state=abc123",
      "hold": 0.4,
      "verdict": "ok"
    }
  },
  "steps": [
    {
      "run": "login",
      "answers": [
        {
          "type": "answered",
          "optionId": "iOA"
        }
      ],
      "expect": {
        "result": "done: 已登录",
        "acpEnv": "ioa",
        "state": {
          "ready": true
        }
      }
    }
  ]
}
