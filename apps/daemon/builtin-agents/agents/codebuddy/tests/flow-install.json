{
  "kind": "agent",
  "description": "install: a confirm card, npm into GeneHub's own prefix, then straight into the account choice on the same job",
  "installed": false,
  "cli": {
    "hello": {
      "currentModelId": "glm",
      "models": [
        {
          "id": "glm",
          "name": "GLM"
        }
      ],
      "commands": []
    },
    "help": "--permission-mode <mode> Permission mode (choices: \"acceptEdits\", \"bypassPermissions\", \"default\", \"plan\")",
    "loggedIn": false,
    "version": "2.5.0",
    "logEnv": [
      "CODEBUDDY_INTERNET_ENVIRONMENT"
    ],
    "acp": {
      "url": "https://www.codebuddy.ai/auth?state=abc123",
      "hold": 0.4,
      "verdict": "ok"
    }
  },
  "steps": [
    {
      "refresh": true,
      "expect": {
        "state": {
          "ready": false,
          "message": "未安装 CodeBuddy",
          "actions": [
            {
              "id": "install"
            }
          ]
        }
      }
    },
    {
      "run": "install",
      "answers": [
        {
          "type": "answered",
          "optionId": "run"
        },
        {
          "type": "answered",
          "optionId": "external"
        }
      ],
      "expect": {
        "result": "done: 已登录",
        "suspended": [
          {
            "step": "install.confirm",
            "title": "安装 CodeBuddy"
          },
          {
            "step": "login.method"
          }
        ],
        "state": {
          "ready": true,
          "version": "2.5.0"
        }
      }
    }
  ]
}
