      "components": [
        {
          "componentId": "worker",
          "role": "coder"
        }
      ],
      "guidance": [
        "这是 Coder WorkerSpace；普通调试 Session 不会自动获得受管 assignment"
      ]
    },
    {
      "name": "reviewer",
      "parent": "executor",
      "lifecycle": "pooled",
      "components": [
        {
          "componentId": "worker",
          "role": "reviewer"
        },
        {
          "componentId": "reviewer"
        }
      ],
      "guidance": [
        "这是 Reviewer WorkerSpace；检查由项目 DCG 派发的实现与证据"
      ]
    },
    {
      "name": "workflow-manager",
      "parent": "executor",
      "lifecycle": "persistent",
      "components": [
        {
          "componentId": "worker",
          "role": "workflow-manager"
        },
        {
          "componentId": "executor"
        }
      ],
      "guidance": [
        "分析最近两次 Workflow 的耗时、返工和 Review，形成改进 Candidate"
      ]
    },
    {
      "name": "workflow-reviewer",
      "parent": "executor",
      "lifecycle": "persistent",
      "components": [
        {
          "componentId": "worker",
          "role": "workflow-reviewer"
        }
      ],
      "guidance": [
        "通过 PM 委托独立评审用户需求的完成质量，并保留会话证据。"
      ]
    }
  ],
