{
  "schema": "genehub.bootstrap-pack.v1",
  "id": "game-delivery-v1",
  "version": 5,
  "description": "Project-owned delivery, business assessment and independent workflow diagnosis.",
  "entrySkill": ".pipebuilder/skills/project-manager/SKILL.md",
  "intentMatches": [
    "new-game",
    "game-feature",
