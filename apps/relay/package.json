{
  "name": "@genehub/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeneHub relay: authenticated byte forwarding between a machine and a browser. No accounts, no storage, no view of the traffic.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --import tsx 'test/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "AGPL-3.0-or-later"
}
