package genehub:host@0.23.0;

/// Spawn a native OS process. WASI has no general exec (WASI#899). Permanent.
///
/// Every operation here is non-blocking, and that is the whole design. A host
/// import that awaits suspends the entire guest instance — Wasmtime runs the
/// guest on one fiber — so a blocking read on one child would stall every other
/// session the daemon is serving. The guest polls instead, backing off on a
/// timer. Reads and waits therefore have to distinguish "nothing yet" from
/// "finished", which is why they return `option`.
interface process {
  record spawn-error {
    message: string,
  }

  resource child {
    /// The native pid, for diagnostics only. The guest must not signal it.
    id: func() -> option<u32>;
    /// `none` at EOF. `some` of an empty list means nothing is buffered yet.
    read-stdout: func(max: u32) -> result<option<list<u8>>, string>;
    read-stderr: func(max: u32) -> result<option<list<u8>>, string>;
    /// Returns how many bytes were accepted, which may be fewer than offered.
    write-stdin: func(data: list<u8>) -> result<u32, string>;
    /// Closes the child's stdin so it can see EOF.
    close-stdin: func() -> result<_, string>;
    /// Asks the whole group to finish. Returns at once — a program that
    /// honours `SIGTERM` needs time to, and waiting for it here would park
    /// every other session. Poll `group-alive` for the answer.
    terminate: func() -> result<_, string>;
    /// Stops the whole group outright.
    kill: func() -> result<_, string>;
    /// Whether anything in the group is still running. A group outlives its
    /// leader as long as one member does, which is the thing being waited out.
    group-alive: func() -> bool;
    /// `none` while the child is still running.
    try-wait: func() -> result<option<u32>, string>;
  }

  /// `env` is applied on top of the shell's own environment.
  ///
  /// Every child leads a session of its own, so that "it and everything it
  /// started" has a name later. Killing a pid reaches that pid alone, and a
  /// dev server forked from a shell that was stopped would otherwise hold its
  /// port until the machine was rebooted. The guest cannot arrange this — it
  /// has no fork to run code between — so the shell does it at spawn, and
  /// `terminate` / `kill` address the group rather than the child.
  spawn: func(
    argv: list<string>,
    env: list<tuple<string, string>>,
    cwd: option<string>,
  ) -> result<child, spawn-error>;

  /// Where `name` is installed on this machine, or nothing.
  ///
  /// The same gap as `spawn`, one question earlier. The daemon offers whichever
  /// agent CLIs are present, so it has to ask; and only the shell can answer,
  /// because `PATH` is a native concept end to end — its separator is the
  /// host's, `PATHEXT` decides what counts as a program on Windows, and WASI
  /// will not even split the list (`std::env::split_paths` is
  /// `panic!("unsupported")` there).
  ///
  /// `extra` is searched after `PATH`, in the order given, for the install
  /// locations the guest knows about and the machine's `PATH` may not mention.
  /// A name that is already a path is answered as itself if it exists.
  locate: func(name: string, extra: list<string>) -> option<string>;

  /// Whether a native pid is still alive on this host. The guest needs this
  /// for same-machine ownership locks; WASI has no process table of its own.
  pid-alive: func(pid: u32) -> bool;

  /// A directory that exists and says nothing about any of the user's
  /// projects: the working directory for a child that must not look like it
  /// was started inside somebody's work.
  ///
  /// Whatever this machine calls "temp", answered by the process that will
  /// actually start the child. WASI has no such notion — `std::env::temp_dir`
  /// aborts the instance there — and the guest cannot guess it either, since
  /// the fallback is `/tmp` on one platform and an environment variable read
  /// through Win32 on another.
  scratch-dir: func() -> string;
}

/// What the kernel will hold a started process to, when the daemon runs
/// something for somebody who is not sitting at this machine.
///
/// WASI cannot ask. The answer is an LSM version syscall and a fork that tries
/// to unshare, and a component has neither — so a guest left to itself must
/// report "nothing is enforced here" on every machine, and refuse every remote
/// terminal on the machines that could in fact have confined it. Permanent
/// while confinement is a native mechanism applied by the process being
/// confined (`packages/native/src/confine.rs`).
interface isolation {
  enum mechanism {
    /// Nothing is in force. Callers that need confinement are refused.
    absent,
    landlock,
    namespaces,
  }

  record report {
    backend: mechanism,
    /// Whether a confined process would really be confined.
    enforced: bool,
    /// Why, in a sentence a person can act on, whether or not it worked.
    detail: string,
  }

  /// A property of the machine, so the shell probes once and every caller gets
  /// that same answer. Two callers must never be told two different stories.
  machine: func() -> report;
}

/// One direct WebRTC data channel, for a peer that can reach this machine
/// better than the relay can carry it.
///
/// WebRTC is ICE over raw UDP, DTLS and SCTP, each with timers of its own, and
/// a component has neither the sockets nor the clock to drive them. So the
/// shell owns the *connection* and nothing else: an offer in, an answer out,
/// and ordered binary messages both ways. Which offer is worth answering, which
/// peer is allowed through, what a message means and how long a stranger may
/// hold a slot all stay in the guest, where the rest of that policy already is.
///
/// Non-blocking throughout, like `process` and `pty`.
interface rtc {
  record config {
    /// STUN/TURN URLs, tried in the order given.
    ice-servers: list<string>,
    /// The one data-channel label this answer accepts. A peer that opens
    /// anything else gets it closed unread, which is cheaper than reading it.
    channel-label: string,
    /// How long to gather candidates before answering with what there is.
    gather-timeout-ms: u32,
    /// Messages larger than this are dropped rather than queued. The guest's
    /// frame limit, restated here so the queue cannot be used to grow the
    /// shell's memory past it.
    max-message-bytes: u32,
    /// How many received messages may wait before the peer is made to wait
    /// too — backpressure, so a peer that talks faster than the guest reads
    /// cannot fill this process up.
    queue-depth: u32,
  }

  enum state {
    /// Still gathering, or still waiting for the peer's channel.
    connecting,
    /// The agreed channel is open.
    open,
    /// Ended, for any reason, including a failure to answer at all. Terminal.
    closed,
  }

  resource session {
    /// The SDP answer, once gathering has finished or run out of time. `none`
    /// until then; `closed` state means there will not be one.
    answer: func() -> option<string>;
    current: func() -> state;
    /// The oldest message the peer sent, or `none` when nothing has arrived.
    /// The end of the connection is `current`, not an empty read.
    receive: func() -> option<list<u8>>;
    /// Queues one binary message. Fails when the channel is not open.
    send: func(data: list<u8>) -> result<_, string>;
  }

  /// Starts answering `offer`. Returns at once; poll `answer` for the SDP.
  /// Dropping the session closes the connection.
  accept: func(offer: string, config: config) -> result<session, string>;
}

/// Unix PTY / Windows ConPTY. WASI has no PTY. Permanent.
///
/// Non-blocking throughout, for the same reason as `process`: the guest runs on
/// one fiber, so an import that waited would stall every other session.
interface pty {
  resource session {
    /// `none` once the shell has exited and the master has drained. `some` of
    /// an empty list means nothing has arrived yet.
    read: func(max: u32) -> result<option<list<u8>>, string>;
    /// Bytes accepted, which may be fewer than offered when the terminal is
    /// not keeping up. That is the backpressure signal.
    write: func(data: list<u8>) -> result<u32, string>;
    resize: func(cols: u16, rows: u16) -> result<_, string>;
    /// `none` while the shell is still running.
    exit-code: func() -> option<s32>;
  }

  /// Dropping the session hangs it up, and deliberately no harder than that. A
  /// command is owned by whoever asked for it; a terminal is not, and somebody
  /// who typed `nohup make &` into one meant it to outlive the window.
  open: func(
    argv: list<string>,
    cwd: string,
    env: list<tuple<string, string>>,
    cols: u16,
    rows: u16,
  ) -> result<session, string>;
}

/// Owner-only permissions. WASI 0.2 filesystem has no permission bits at all,
/// so this is not a gap the guest can work around — a rule the interface cannot
/// express is a rule the guest cannot enforce. Permanent while that holds.
interface fs-perms {
  /// `0o600` for a file, `0o700` for a directory; on Windows, an ACL naming
  /// only the current user. Applied to paths that already exist, because
  /// tightening one somebody else loosened is half of what this is for.
  restrict-to-owner: func(path: string) -> result<_, string>;
}

/// Kernel flock. WASI 0.2 filesystem types have no lock-*. Drop must unlock.
/// Delete when Wasmtime ships stable filesystem locks.
interface file-lock {
  resource handle {
    try-lock-shared: func() -> result<bool, string>;
    try-lock-exclusive: func() -> result<bool, string>;
    unlock: func() -> result<_, string>;
  }

  open: func(path: string) -> result<handle, string>;
}

/// Host-owned signed component update. The guest may ask to check or apply;
/// it cannot name a URL, path, version, channel or key.
interface component-update {
  record status {
    /// Canonical Product Version currently active on this channel.
    current-version: string,
    latest-version: option<string>,
    newer: bool,
    problem: option<string>,
  }

  check: func() -> result<status, string>;
  /// Stages, fences and atomically replaces the active component. The caller
  /// should then return "reload". Sessions and child processes are dropped.
  apply: func(request-id: string) -> result<_, string>;
}

/// The one v2 artifact. A single component carries both entries; the shell
/// picks one per OS process (`genehub-host-dev run --entry daemon|agent`).
world daemon {
  import process;
  import pty;
  import rtc;
  import file-lock;
  import fs-perms;
  import isolation;
  import component-update;
  /// Resident daemon. Returns "reload" or "shutdown".
  export run: func() -> result<string, string>;
  /// Independent OS process: same artifact, agent entry.
  export agent-run: func() -> result<u32, string>;
}
